{
  "schema": "dayz.policy.v1",
  "version": "dayz-policy-v1",
  "limits": {
    "batch_max_bytes": 262144,
    "batch_max_events": 100,
    "batch_max_attempts": 5,
    "event_max_bytes": 65536,
    "event_max_age_hours": 72,
    "event_max_future_seconds": 300,
    "processing_ttl_max_seconds": 86400,
    "private_retention_hours": 24,
    "event_retention_hours": 72,
    "delivery_retention_days": 14,
    "public_delay_seconds": 600,
    "game_message_max_chars": 160,
    "signal_ttl_max_seconds": 300,
    "telegram_message_max_chars": 3500,
    "public_message_max_chars": 120,
    "snapshot_fresh_seconds": 180,
    "command_player_cooldown_seconds": 60,
    "command_global_cooldown_seconds": 15,
    "auto_game_min_interval_seconds": 120,
    "auto_game_max_per_10_minutes": 3,
    "auto_game_window_seconds": 600,
    "game_global_cooldown_seconds": 120,
    "digest_window_seconds": 3600,
    "chronicle_window_seconds": 3600,
    "chronicle_min_significant_events": 3,
    "batch_lease_seconds": 300,
    "delivery_lease_seconds": 30,
    "delivery_scan_interval_seconds": 60,
    "signal_reconcile_buffer_seconds": 15,
    "delivery_max_attempts": 3,
    "delivery_retry_seconds": [30, 120]
  },
  "event_types": {
    "player.command": {"max_audience": "public", "immediate_channels": ["game"], "digest": false},
    "player.sos": {"max_audience": "public", "immediate_channels": ["telegram", "game"], "digest": false},
    "player.admin_message": {"max_audience": "public", "immediate_channels": ["telegram", "game"], "digest": false},
    "player.connected": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "player.disconnected": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "player.unconscious": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "player.recovered": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "player.suicide": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "player.death": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "player.killed": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "combat.pvp": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "combat.pvp_kill": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "combat.explosion": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "combat.trap": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "combat.infected_pressure": {"max_audience": "public", "immediate_channels": [], "digest": false, "chronicle": true},
    "combat.vehicle_incident": {"max_audience": "public", "immediate_channels": [], "digest": false, "chronicle": true},
    "combat.wildlife_pressure": {"max_audience": "public", "immediate_channels": [], "digest": false, "chronicle": true},
    "base.placed": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "base.built": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "base.dismantled": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "telemetry.started": {"max_audience": "admin", "immediate_channels": [], "digest": false},
    "telemetry.stopped": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "telemetry.error": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "world.snapshot": {"max_audience": "public", "immediate_channels": [], "digest": true},
    "world.event.present": {"max_audience": "public_delayed", "immediate_channels": ["telegram"], "digest": false},
    "world.event.started": {"max_audience": "public_delayed", "immediate_channels": ["telegram"], "digest": false},
    "world.event.updated": {"max_audience": "public_delayed", "immediate_channels": ["telegram"], "digest": false},
    "world.event.ended": {"max_audience": "public_delayed", "immediate_channels": ["telegram"], "digest": false},
    "server.started": {"max_audience": "public", "immediate_channels": ["telegram"], "digest": false},
    "server.restart_due": {"max_audience": "public", "immediate_channels": ["telegram", "game"], "digest": false},
    "server.stopping": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "server.economy_anomaly": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "server.script_error": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "server.telemetry_stale": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "storage.health_anomaly": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false},
    "storage.health_recovered": {"max_audience": "admin", "immediate_channels": ["telegram"], "digest": false}
  }
}

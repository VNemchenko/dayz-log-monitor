{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/dayz.event-batch.v1.schema.json",
  "title": "dayz-log-monitor event batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "sent_at", "producer", "events"],
  "properties": {
    "schema": {"const": "dayz.event-batch.v1"},
    "batch_id": {"type": "string", "pattern": "^batch_[0-9a-f]{32}$"},
    "sent_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {"const": "dayz-log-monitor"},
        "source": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "dayz.event.v1.schema.json"}
    }
  }
}
